# ==========================================
# AutoDrift Car Detailing - Environment Variables
# ==========================================

# 1. Supabase PostgreSQL Database Connection
# Use the connection pooling URL (Transaction or Session mode) for Prisma:
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations/db push (Session mode or direct connection):
DIRECT_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. Supabase API & Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Google Gemini API (Server-side car size AI recommendation)
GEMINI_API_KEY="AIzaSy..."

# 4. App URL (for redirects & deployment)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
